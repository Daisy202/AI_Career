# Local Ollama (offline mode — default in Admin → AI Settings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# GitHub Models (online mode — set in Admin panel; key stays in .env only)
ONLINE_API_KEY=your_github_pat_with_models_read_scope
ONLINE_MODEL=openai/gpt-4.1

# Legacy names also supported:
# online_apikey=
# Online_model=
